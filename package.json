{
  "name": "catalogo-ferreteria",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs",
    "prestart": "npm run build",
    "start": "node server.js",
    "test": "node --test catalog.test.js tests/*.test.js",
    "test:browser": "npm run build && playwright test",
    "package:deploy": "npm run build && python3 scripts/package_deploy.py"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@playwright/test": "^1.64.1",
    "esbuild": "^0.28.2"
  }
}
